# Copia estos nombres en Vercel → Settings → Environment Variables
# (Production, Preview y Development)

# --- Firebase prestamos (consola Firebase → Configuración del proyecto → Web) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- SSO CampusFlow (MISMO valor que SSO_SECRET en cdr-landing) ---
SSO_SECRET=

# --- Gym Control CDU (lookup usuarios; mismo proyecto que stock_cdu_Sanfer) ---
NEXT_PUBLIC_GYM_FIREBASE_API_KEY=
NEXT_PUBLIC_GYM_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_GYM_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_GYM_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_GYM_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_GYM_FIREBASE_APP_ID=

# URL pública de CDUControl (ya no se usa para préstamos; el registro vive en Asistencias)
NEXT_PUBLIC_URL_GYM_CDU=https://gym-cdu-two.vercel.app

# --- Asistencias (búsqueda de participantes; solo lectura de user_profiles) ---
NEXT_PUBLIC_ASISTENCIA_CULTURA_API_KEY=
NEXT_PUBLIC_ASISTENCIA_CULTURA_AUTH_DOMAIN=
NEXT_PUBLIC_ASISTENCIA_CULTURA_PROJECT_ID=
NEXT_PUBLIC_ASISTENCIA_CULTURA_STORAGE_BUCKET=
NEXT_PUBLIC_ASISTENCIA_CULTURA_MESSAGING_SENDER_ID=
NEXT_PUBLIC_ASISTENCIA_CULTURA_APP_ID=
NEXT_PUBLIC_ASISTENCIA_DEPORTE_API_KEY=
NEXT_PUBLIC_ASISTENCIA_DEPORTE_AUTH_DOMAIN=
NEXT_PUBLIC_ASISTENCIA_DEPORTE_PROJECT_ID=
NEXT_PUBLIC_ASISTENCIA_DEPORTE_STORAGE_BUCKET=
NEXT_PUBLIC_ASISTENCIA_DEPORTE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_ASISTENCIA_DEPORTE_APP_ID=

# --- Google Drive de Préstamos (cliente PrestamosAdmin, no el de Asistencias) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/drive/oauth/callback
GOOGLE_DRIVE_FOLDER_ID=
# Tras /conectar-drive el permiso queda en secrets.drive-oauth.json.
# En Vercel cópialo a GOOGLE_OAUTH_REFRESH_TOKEN y no lo compartas.
