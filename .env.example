# Copia estos nombres en Vercel → Settings → Environment Variables
# (Production, Preview y Development)

# --- Firebase prestamos (consola Firebase → Configuración del proyecto → Web) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- SSO CampusFlow (MISMO valor que SSO_SECRET en cdr-landing) ---
SSO_SECRET=

# --- Gym Control CDU (solo lectura de usuarios miembros) ---
# Mismas credenciales que GYM_CDU_ADMIN_* en cdr-landing
GYM_CDU_ADMIN_PROJECT_ID=
GYM_CDU_ADMIN_CLIENT_EMAIL=
GYM_CDU_ADMIN_PRIVATE_KEY=

# URL pública de Gym Control (link de registro para no inscritos)
NEXT_PUBLIC_URL_GYM_CDU=

# --- Google Drive (solo si usas subida de PDF en reservas Meléndez) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
